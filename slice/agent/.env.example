# Required: Claude API key (or run `ant auth login`)
ANTHROPIC_API_KEY=
# Optional but recommended: richer, cheaper checks than web search alone
GOOGLE_MAPS_API_KEY=
OPENCORPORATES_API_TOKEN=
# Optional: publish the trust score on-chain as a SliceHub verifier
RPC_URL=
VERIFIER_PRIVATE_KEY=
SLICE_HUB=
# Server
PORT=8787
ALLOW_ORIGIN=*
